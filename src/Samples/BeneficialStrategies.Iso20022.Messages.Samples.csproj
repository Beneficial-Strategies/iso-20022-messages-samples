<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same targets as the Factory, which builds the objects. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022.Messages.Samples</RootNamespace>
    <AssemblyName>BeneficialStrategies.Iso20022.Messages.Samples</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageFiles>$(MSBuildThisFileDirectory)..\..\artifacts\package\</PackageFiles>
    <PackageId>BeneficialStrategies.Iso20022.Messages.Samples</PackageId>
    <PackageDescription>Named, valid ISO 20022 objects for tests, and a generated minimal valid object for any interface of the model, built through the Factory against the interfaces, so a test needs no message records.</PackageDescription>
    <!-- The README and the release notes of a release are made by tools/package/prepare_package_files.py; without them (a local pack) the README of the repository is used. -->
    <PackageReleaseNotes Condition="Exists('$(PackageFiles)release-notes.txt')">$([System.IO.File]::ReadAllText("$(PackageFiles)release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PackageFiles)README.md" Pack="true" PackagePath="\" Condition="Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="!Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\.beneficial\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- From the lowest version that works to just below the next breaking change. -->
    <PackageReference Include="BeneficialStrategies.Iso20022.Primitives" Version="[1.1.1, 1.2.0)" />
    <PackageReference Include="BeneficialStrategies.Iso20022.Messages" Version="[1.0.1, 1.1.0)" />
    <PackageReference Include="BeneficialStrategies.Iso20022.Factory" Version="[1.0.0, 1.1.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BeneficialStrategies.Iso20022.Messages.Samples.Tests" />
    <InternalsVisibleTo Include="BeneficialStrategies.Iso20022.FluentValidation.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
